  "description": "API RESTful QUACKROOM - Node.js, TypeScript, Express y Supabase",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit"
